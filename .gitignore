# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore NixOS interactive test driver history
**/.nixos-test-history

# Secure Boot key backups (secret material, never commit)
sbctl-backup-*.tar.gz

# Plaintext/decrypted secret material (never commit; see `just secrets-decrypt`)
secrets/*.decrypted
secrets/*.plaintext
*.key
