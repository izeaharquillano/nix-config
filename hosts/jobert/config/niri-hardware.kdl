output "eDP-1" {
    mode "1920x1080@144"
    scale 1.20
    transform "normal"
}

output "DP-1" {
    mode "2560x1440@143.999"
    scale 1.0
    transform "normal"
    position x=0 y=0
}

debug {
    // render-drm-device "/dev/dri/renderD128"
    // ignore-drm-device "/dev/dri/renderD129"
    // disable-direct-scanout false
    // wait-for-frame-completion-before-queueing
    emulate-zero-presentation-time
}
