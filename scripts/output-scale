#!/usr/bin/env bash
# Scale focused Niri/Hyprland output: `[scale|+|-|empty]` (empty cycles presets).
# e.g. `output-scale 2`, `output-scale +`; via https://github.com/nickjj

if [ -n "${NIRI_SOCKET}" ]; then
  compositor="niri"
elif [ -n "${HYPRLAND_INSTANCE_SIGNATURE}" ]; then
  compositor="hyprland"
else
  echo "No supported compositor detected (Niri or Hyprland), aborting!" >&2
  exit 1
fi

readonly SCALES=(1.0 1.25 1.5 1.75 2.0 2.5 3.0 4.0 5.0)

scale_to_int() {
  awk -v v="${1}" 'BEGIN {printf "%.0f", v * 100}'
}

int_to_scale() {
  local value="${1}"

  for scale in "${SCALES[@]}"; do
    if [ "$(scale_to_int "${scale}")" == "${value}" ]; then
      printf "%s\n" "${scale}"
      return 0
    fi
  done

  return 1
}

scale_index() {
  local value="${1}"

  for scale in "${!SCALES[@]}"; do
    if [ "$(scale_to_int "${SCALES[${scale}]}")" == "${value}" ]; then
      printf "%s\n" "${scale}"
      return 0
    fi
  done

  return 1
}

adjust_scale() {
  # NOTE: takes the current scale as an integer (scale*100), NOT a preset
  # index, so non-preset scales (e.g. 1.2) work. `+`/`-`/`cycle` snap to the
  # nearest preset; explicit values accept any positive number.
  local input="${1}"
  local current_int="${2}"
  local last_index=$(( ${#SCALES[@]} - 1 ))

  case "${input}" in
  +)
    local scale preset_int
    for scale in "${SCALES[@]}"; do
      preset_int="$(scale_to_int "${scale}")"
      if [ "${preset_int}" -gt "${current_int}" ]; then
        printf '%s\n' "${scale}"
        return 0
      fi
    done
    # Already at/above max: clamp to max preset.
    printf '%s\n' "${SCALES[${last_index}]}"
    ;;

  -)
    local result="${SCALES[0]}"
    local scale preset_int
    for scale in "${SCALES[@]}"; do
      preset_int="$(scale_to_int "${scale}")"
      if [ "${preset_int}" -lt "${current_int}" ]; then
        result="${scale}"
      else
        break
      fi
    done
    printf '%s\n' "${result}"
    ;;

  cycle)
    local scale preset_int
    for scale in "${SCALES[@]}"; do
      preset_int="$(scale_to_int "${scale}")"
      if [ "${preset_int}" -gt "${current_int}" ]; then
        printf '%s\n' "${scale}"
        return 0
      fi
    done
    # Wrap around when at/above max.
    printf '%s\n' "${SCALES[0]}"
    ;;

  *)
    if [[ ! "${input}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
      echo "'${input}' is not valid, use a positive number, '+', '-', or leave empty to cycle (presets: ${SCALES[*]})" >&2
      return 1
    fi

    local key
    key="$(scale_to_int "${input}")"
    if [ "${key}" -le 0 ]; then
      echo "'${input}' is not valid, scale must be positive" >&2
      return 1
    fi

    local s
    if s="$(int_to_scale "${key}")"; then
      printf '%s\n' "${s}"
    else
      # Accept non-preset scales (compositors support arbitrary floats).
      printf '%s\n' "${input}"
    fi
    ;;
  esac
}

# --- Niri functions ---

get_state_niri() {
  niri msg --json outputs
}

get_focused_niri() {
  niri msg --json focused-output | jq -r '.name'
}

# Returns: x y width height scale
get_output_info_niri() {
  jq --raw-output --arg output "${2}" '
    .[$output].logical
    | "\(.x) \(.y) \(.width) \(.height) \(.scale)"
  ' <<<"${1}"
}

set_scale_niri() {
  niri msg output "${1}" scale "${2}"
}

position_outputs_niri() {
  local state="${1}"
  local focused="${2}"
  local dx="${3}"
  local dy="${4}"
  local old_x="${5}"
  local old_y="${6}"
  local old_w="${7}"
  local old_h="${8}"

  while read -r name x y; do
    [ "${name}" == "${focused}" ] && continue

    local new_x="${x}"
    local new_y="${y}"

    ((x >= old_x + old_w)) && new_x=$((x + dx))
    ((y >= old_y + old_h)) && new_y=$((y + dy))

    if [[ "${new_x}" != "${x}" || "${new_y}" != "${y}" ]]; then
      niri msg output "${name}" position set "${new_x}" "${new_y}"
    fi

  done < <(
    jq -r '
      to_entries[]
      | "\(.key) \(.value.logical.x) \(.value.logical.y)"
    ' <<<"${state}"
  )
}

# --- Hyprland functions ---

get_state_hyprland() {
  hyprctl monitors -j
}

get_focused_hyprland() {
  jq -r '.[] | select(.focused == true) | .name' <<<"${1}"
}

# Returns: x y width height scale
get_output_info_hyprland() {
  jq --raw-output --arg output "${2}" '
    .[] | select(.name == $output)
    | "\(.x) \(.y) \(.width) \(.height) \(.scale)"
  ' <<<"${1}"
}

set_scale_hyprland() {
  local name="${1}"
  local scale="${2}"
  local x="${3}"
  local y="${4}"

  hyprctl eval "hl.monitor({output = \"${name}\", mode = \"preferred\", position = \"${x}x${y}\", scale = ${scale}})" >/dev/null
}

position_outputs_hyprland() {
  local state="${1}"
  local focused="${2}"
  local dx="${3}"
  local dy="${4}"
  local old_x="${5}"
  local old_y="${6}"
  local old_w="${7}"
  local old_h="${8}"
  local new_scale="${9}"

  while read -r name x y scale; do
    [ "${name}" == "${focused}" ] && continue

    local new_x="${x}"
    local new_y="${y}"

    ((x >= old_x + old_w)) && new_x=$((x + dx))
    ((y >= old_y + old_h)) && new_y=$((y + dy))

    if [[ "${new_x}" != "${x}" || "${new_y}" != "${y}" ]]; then
      set_scale_hyprland "${name}" "${scale}" "${new_x}" "${new_y}"
    fi

  done < <(
    jq -r '.[] | "\(.name) \(.x) \(.y) \(.scale)"' <<<"${state}"
  )
}

# --- Main ---

main() {
  local state_before
  state_before="$(get_state_${compositor})"

  local focused_output
  focused_output="$(get_focused_${compositor} "${state_before}")"

  if [ -z "${focused_output}" ]; then
    echo "Could not determine focused output, aborting!" >&2
    exit 1
  fi

  local old_x old_y old_w old_h current_scale
  read -r old_x old_y old_w old_h current_scale <<<"$(get_output_info_${compositor} "${state_before}" "${focused_output}")"

  if [ -z "${current_scale:-}" ]; then
    echo "Could not determine current scale for '${focused_output}', aborting!" >&2
    exit 1
  fi

  # Integer form (scale*100) so non-preset scales (e.g. 1.2) compare correctly.
  # NOTE: must not call scale_index here — it exits 1 for non-preset scales,
  # which aborts the script under `set -o errexit` (writeShellApplication).
  local current_scale_int
  current_scale_int="$(scale_to_int "${current_scale}")"

  local new_scale
  if ! new_scale="$(adjust_scale "${1:-cycle}" "${current_scale_int}")"; then
    exit 1
  fi

  set_scale_${compositor} "${focused_output}" "${new_scale}" "${old_x}" "${old_y}"

  local state_after
  state_after="$(get_state_${compositor})"

  # Reuse the per-compositor helper: Niri state is an object keyed by output
  # name, Hyprland is an array — a hardcoded Hyprland-only `jq '.[]...'` breaks Niri.
  # `get_output_info_*` returns `x y width height scale`.
  read -r _ _ new_w new_h _ <<<"$(get_output_info_${compositor} "${state_after}" "${focused_output}")"

  local dx=$((new_w - old_w))
  local dy=$((new_h - old_h))

  position_outputs_${compositor} \
    "${state_before}" \
    "${focused_output}" \
    "${dx}" \
    "${dy}" \
    "${old_x}" \
    "${old_y}" \
    "${old_w}" \
    "${old_h}" \
    "${new_scale}"

  noctalia msg notification-show "Output ${focused_output} scale: ${new_scale}x" "output-scale" || true
}

main "${@}"
